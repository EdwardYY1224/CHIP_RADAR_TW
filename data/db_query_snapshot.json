  "15": {
   "title": "活躍天數分布: 每位 master 出手天數 + 平均單日金額",
   "sql": "SELECT t.name AS master, COUNT(DISTINCT dc.date) AS active_days, ROUND(SUM(dc.buy_amt)/10.0 / NULLIF(COUNT(DISTINCT dc.date), 0)) AS avg_day_wan, SUM(dc.buy_amt)/10 AS total_wan FROM daily_chips dc JOIN traders t ON dc.trader_id=t.id WHERE dc.buy_lots>0 AND dc.source='raw' GROUP BY t.name ORDER BY active_days DESC LIMIT 30",
   "columns": [
    "master",
    "active_days",
    "avg_day_wan",
