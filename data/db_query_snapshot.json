   "sql": "SELECT t.name AS trader, s.code, s.name AS stock_name, COUNT(DISTINCT dc.date) AS days, SUM(dc.buy_amt)/10 AS cum_buy_wan, SUM(dc.buy_lots) AS cum_buy_lot FROM daily_chips dc JOIN traders t ON dc.trader_id=t.id JOIN stocks s ON dc.stock_id=s.id WHERE dc.buy_lots>0 AND dc.source='raw' GROUP BY t.name, s.code HAVING COUNT(DISTINCT dc.date)>=5 ORDER BY days DESC, cum_buy_wan DESC LIMIT 30",
