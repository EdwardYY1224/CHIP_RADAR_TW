  "10": {
   "title": "隔日沖驗證: 昨日漲停買進 + 今日賣出 (T+1 flip)",
   "sql": "WITH lu_buys AS (  SELECT date, trader_id, stock_id, buy_lots FROM daily_chips   WHERE is_limit_up=1 AND buy_lots>0 AND source='raw') SELECT t.name AS master, s.code, s.name AS stock_name, lu.date AS buy_date, lu.buy_lots, next_dc.date AS sell_date, next_dc.sell_lots, ROUND(100.0 * next_dc.sell_lots / lu.buy_lots, 1) AS flip_pct FROM lu_buys lu LEFT JOIN daily_chips next_dc   ON next_dc.trader_id=lu.trader_id AND next_dc.stock_id=lu.stock_id   AND next_dc.date > lu.date AND next_dc.sell_lots > 0 JOIN traders t ON lu.trader_id=t.id JOIN stocks s ON lu.stock_id=s.id WHERE next_dc.date IS NOT NULL ORDER BY lu.date DESC, flip_pct DESC LIMIT 30",
   "columns": [
    "master",
    "code",
    "stock_name",
    "buy_date",
    "buy_lots",
    "sell_date",
    "sell_lots",
    "flip_pct"
   ],
   "rows": [],
   "row_count": 0,
   "truncated": false
  },
