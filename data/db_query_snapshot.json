  "12": {
   "title": "Master 風格畫像: 各 master 漲停買進 vs 一般買進比",
   "sql": "SELECT t.name AS master, SUM(CASE WHEN dc.is_limit_up=1 THEN dc.buy_amt ELSE 0 END)/10 AS lu_buy_wan, SUM(CASE WHEN dc.is_limit_up=0 THEN dc.buy_amt ELSE 0 END)/10 AS normal_buy_wan, ROUND(100.0 * SUM(CASE WHEN dc.is_limit_up=1 THEN dc.buy_amt ELSE 0 END)   / NULLIF(SUM(dc.buy_amt), 0), 1) AS lu_pct, COUNT(DISTINCT dc.date) AS active_days FROM daily_chips dc JOIN traders t ON dc.trader_id=t.id WHERE dc.buy_lots>0 AND dc.source='raw' GROUP BY t.name HAVING COUNT(DISTINCT dc.date)>=5 ORDER BY lu_pct DESC LIMIT 20",
   "columns": [
    "master",
    "lu_buy_wan",
    "normal_buy_wan",
    "lu_pct",
